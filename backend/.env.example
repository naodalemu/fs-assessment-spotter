# OpenRouteService key (free at https://openrouteservice.org/dev/#/signup).
# Without it the app falls back to clearly-labelled simulated routes.
ORS_API_KEY=your_openrouteservice_api_key_here

# Weather: "open-meteo" (live, no key needed) or "simulated" (demo weather fronts)
WEATHER_PROVIDER=open-meteo

# Forecast locations per search. 300 fits Open-Meteo's free tier; 0 = no limit (paid plan).
FORECAST_LOCATION_BUDGET=300

DJANGO_SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
